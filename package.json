{
  "name": "villa-diodati",
  "displayName": "Villa Diodati",
  "description": "Gothic dark themes for VS Code and Cursor in near-black moss, veil teal and acid gold: Villa Diodati and Villa Diodati Crypt Black.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "publisher": "rgsx",
  "repository": {
    "type": "git",
    "url": "https://github.com/rgsx/villa-diodati"
  },
  "homepage": "https://github.com/rgsx/villa-diodati#readme",
  "bugs": {
    "url": "https://github.com/rgsx/villa-diodati/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "icons": "python3 scripts/make-icons.py",
    "screenshots": "python3 scripts/make-screenshots.py",
    "package": "npm run build && npx @vscode/vsce package",
    "publish:ovsx": "npm run build && npx ovsx publish"
  },
  "keywords": [
    "Theme",
    "Dark Theme",
    "Gothic",
    "Frankenstein",
    "Mary Shelley",
    "Villa Diodati",
    "Ingolstadt",
    "Galvanism",
    "Lightning",
    "Cursor",
    "Black Theme",
    "Green Theme",
    "Moss"
  ],
  "categories": [
    "Themes"
  ],
  "galleryBanner": {
    "color": "#12160f",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Villa Diodati",
        "uiTheme": "vs-dark",
        "path": "./themes/villa-diodati-color-theme.json"
      },
      {
        "label": "Villa Diodati Crypt Black",
        "uiTheme": "vs-dark",
        "path": "./themes/villa-diodati-crypt-black-color-theme.json"
      }
    ]
  },
  "icon": "assets/images/villa-diodati-logo.png"
}
